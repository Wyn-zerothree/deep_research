# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不要提交）
#
# 阿里云百炼 API Key (必需，用于 LLM 与 Embedding)
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
MODEL=qwen-plus

# 博查 Web Search API Key (可选；不填则 web_search 节点检索为空)
# 获取地址: https://open.bochaai.com/
BOCHA_API_KEY=

# 会话标识
THREAD_ID=default
USER_ID=default_user
TENANT_ID=default_tenant

# 反思循环上限
MAX_ITERATIONS=3

# 记忆开关与短期记忆
ENABLE_MEMORY=true
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
SAVE_CONVERSATION_TASK=false
CHECKPOINTER_BACKEND=auto
MEMORY_TOP_K=6

# 存储后端 (留空则逐级降级到 SQLite / 内存)
REDIS_URL=
POSTGRES_DSN=
ENABLE_MILVUS=true
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory

# 以下仅影响 tools.py 中的桩工具（文件系统类），不影响主流程
NO_COLOR=
WORKSPACE_DIR=/workspace
